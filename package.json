{
  "name": "cfs-2026-notas",
  "version": "1.0.6",
  "private": true,
  "engines": {
    "node": "22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-sqlite node_modules/next/dist/bin/next dev",
    "build": "node --experimental-sqlite node_modules/next/dist/bin/next build",
    "start": "npm run start:render",
    "start:local": "node --experimental-sqlite node_modules/next/dist/bin/next start",
    "start:render": "node --experimental-sqlite --import tsx lib/render-bootstrap.ts && node --experimental-sqlite node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "verify": "node verificar-repositorio.mjs",
    "db:seed": "node --experimental-sqlite --import tsx scripts/seed.ts",
    "db:reset": "node --experimental-sqlite --import tsx scripts/reset-db.ts",
    "db:bootstrap": "node --experimental-sqlite --import tsx lib/render-bootstrap.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
