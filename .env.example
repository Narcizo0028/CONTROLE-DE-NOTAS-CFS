# Copie para .env.local (desenvolvimento) ou configure no painel do Render (produção)

# Obrigatório em produção — gere uma chave longa e aleatória
JWT_SECRET=altere-esta-chave-secreta-em-producao

# Diretório do SQLite (Render: monte disco persistente em /var/data)
# DATABASE_DIR=/var/data

# Caminho completo opcional do arquivo .db
# DATABASE_PATH=/var/data/cfs2026.db

# Popular usuários/discentes de demonstração na 1ª inicialização (true/false)
SEED_DEMO_DATA=true

# Vercel/Netlify: SQLite em /tmp (não persistente). Render: DATABASE_DIR=/var/data
# VERCEL e NETLIFY são detectados automaticamente

# Ambiente Node
NODE_ENV=production
